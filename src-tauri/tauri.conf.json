{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neyra",
  "version": "../package.json",
  "identifier": "com.seventhfret.neyra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NEM5RThBOEMzNzNFRDYKUldUV1BqZU1pcDVNeFVUd3pmK01oL0RVSHZPeHB4QmRjL2pLaWlraS9jT3UyTkNtcllyUUV0WVgK",
      "endpoints": [
        "https://github.com/SeventhFret/neyra/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Neyra",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
